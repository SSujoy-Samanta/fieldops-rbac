# ==============================================================================
# Node.js & Express Backend .gitignore
# ==============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build Outputs & Compiled Code ───────────────────────────────────────────
dist/
build/
/src/generated/prisma

# ── Environment & Secrets ───────────────────────────────────────────────────
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# ── TypeScript Build Cache ───────────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Logs & Debug Files ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Testing & Coverage ───────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── OS & IDE Artifacts ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
*.pem
.idea/
.vscode/

# ── AI & IDE Agent Folders & Instruction Files ──────────────────────────────
.agents/
.claude/
.windsurf/
.gemini/
AGENTS.md
CLAUDE.md

# ── Temporary & Scratch Files ───────────────────────────────────────────────
temp/
tmp/
