# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
PLATFORM_DOMAIN=localhost # e.g. 'fieldops.dev' in production, 'localhost' in dev

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# JWT & Security Secrets
JWT_SECRET="your-secure-32-plus-char-jwt-secret"
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL=604800

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend Email (For Password Reset)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="FieldOps Security <onboarding@resend.dev>"
