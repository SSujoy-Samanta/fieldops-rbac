# ==============================================================================
# RBAC Enterprise Frontend - Minimal Environment Variables Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
# ==============================================================================

# ── 1. Backend Server API URL (Required) ──────────────────────────────────────
# The URL of your Node.js/Express backend server.
# Used by Next.js in 'next.config.ts' to proxy /api/* calls to backend.
NEXT_PUBLIC_API_URL="http://localhost:5000"

# ── 2. Frontend Public Web App URL (Required for OAuth & SEO) ────────────────
# The URL of this Next.js web application.
# Used for OAuth callback redirects and canonical URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
