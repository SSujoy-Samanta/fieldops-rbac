{
  "name": "fieldops-access-test",
  "version": "1.0.0",
  "private": true,
  "description": "FieldOps Access Test - Next.js + Express + PostgreSQL + Prisma + Redis TypeScript RBAC Application",
  "scripts": {
    "dev": "pnpm --parallel --filter backend --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --recursive run build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --filter backend test",
    "seed": "pnpm --filter backend seed"
  },
  "keywords": [
    "pern",
    "rbac",
    "typescript",
    "nextjs",
    "express",
    "postgresql",
    "prisma",
    "redis"
  ],
  "author": "Sujoy Samanta",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
