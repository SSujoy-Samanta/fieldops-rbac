# ==============================================================================
# Monorepo Root .dockerignore
# ==============================================================================

# Dependencies
**/node_modules
**/.pnp
**/.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build Outputs & Next.js Cache
**/dist
**/build
**/out
**/.next
**/.turbo
**/*.tsbuildinfo

# Environment Variables
**/.env
**/.env*.local
**/.env.development
**/.env.production
!**/.env.example

# Git & Agent Metadata
.git
.gitignore
.agents
.claude
.windsurf
.gemini

# IDE & OS Artifacts
.idea
.vscode
**/.DS_Store
**/Thumbs.db
**/*.pem

# Testing & Temp
**/coverage
**/temp
**/tmp
